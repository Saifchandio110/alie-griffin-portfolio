# Add these in Vercel (Project Settings -> Environment Variables).
# Both values are public-safe and come from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Paste the PUBLISHABLE key (starts with sb_publishable_) here. The variable name is historical.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
# Never add the secret key or service_role key to this project.
